    "approve": [
      true,
      true
    ]
  },
  "script": [
    {
      "calls": [
        {
          "name": "filesystem__write_file",
          "args": {
            "path": "{root}/b.txt",
            "content": "updated"
          }
        }
      ]
    },
    {
      "calls": [
        {
          "name": "filesystem__write_file",
          "args": {
            "path": "{root}/a.txt",
            "content": "updated"
          }
        }
      ]
    },
    {
      "text": "바꿨습니다."
    }
  ],
  "expect": {
    "files": {
      "b.txt": "updated"
    }
  }
}
