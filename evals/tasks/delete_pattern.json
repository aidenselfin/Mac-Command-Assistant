{
  "id": "delete_pattern",
  "family": "file.delete.batch",
  "files": {
    "삭제연습/임시-1.txt": "1",
    "삭제연습/임시-2.txt": "2",
    "삭제연습/keep.md": "keep"
  },
  "request": "삭제연습 폴더의 *.txt 파일을 모두 삭제해줘",
  "user": {
    "approve": [
      true
    ]
  },
  "script": [
    {
      "calls": [
        {
          "name": "local__delete_files",
          "args": {
            "directory": "{root}/삭제연습",
            "pattern": "*.txt"
          }
        }
      ]
    },
    {
      "text": "삭제했습니다."
    }
  ],
  "expect": {
    "files": {
      "삭제연습/임시-1.txt": null,
      "삭제연습/임시-2.txt": null
    }
  }
}
